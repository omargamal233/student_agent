# Copy to .env and fill in. Never commit the real .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (reasoning effort of the gpt-oss model)
REASONING_EFFORT=medium
TEMPERATURE=0.2
# Optional: pin "today" (YYYY-MM-DD). Leave empty to use the data source's date,
# or the real date when the data source has none.
# AS_OF_DATE=2026-11-18

# API server
API_HOST=127.0.0.1
API_PORT=8000
